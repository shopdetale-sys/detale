rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─── Helpers ────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'ADMIN';
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isValidImage() {
      return request.resource.contentType.matches('image/.*')
          && request.resource.size < 10 * 1024 * 1024; // 10 MB
    }

    // ─── Product Images ──────────────────────────────────────────────────────
    match /products/{allPaths=**} {
      allow read, write: if true;
    }

    // ─── Vendor Assets ───────────────────────────────────────────────────────
    match /vendors/{vendorId}/{assetId} {
      allow read: if true;
      allow write: if isOwner(vendorId) && isValidImage();
      allow delete: if isOwner(vendorId) || isAdmin();
    }

    // ─── User Avatars ────────────────────────────────────────────────────────
    match /avatars/{userId}/{imageId} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidImage();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ─── Banner / Admin Assets ───────────────────────────────────────────────
    match /banners/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Category Icons ──────────────────────────────────────────────────────
    match /categories/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Deny everything else ────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
